# Mẫu biến môi trường. Chép thành .env rồi điền (npm run dev tự đọc .env). Tất cả đều không bắt buộc.
# Trên Render: điền ở phần Environment của từng service, không dùng file này.

# Cổng server (mặc định 8000)
# PORT=8000

# Chỉ chạy một số cơ sở, cách nhau dấu phẩy (mặc định chạy tất cả)
# ROOMS=quan-1

# Domain trang web được phép kết nối, cách nhau dấu phẩy
# ALLOWED_ORIGINS=https://boihiaonline.vercel.app

# Đặt 1 khi chạy sau reverse proxy (Render, Cloudflare) để lấy đúng IP người chơi
# TRUST_PROXY=1

# Số kết nối tối đa mỗi IP (mặc định 4)
# MAX_CONN_PER_IP=4

# Tìm bài trên YouTube bằng API chính thức (không có thì đọc trang kết quả tìm kiếm)
YOUTUBE_API_KEY=

# Lưu ví, hoá đơn, mồi trên bàn lên Upstash Redis để deploy lại không mất (không có thì lưu file data/state.json)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# STATE_FILE=data/state.json

# Thời gian giữ chỗ bàn chưa trả tiền, mili giây (mặc định 180000 = 3 phút)
# HOLD_MS=180000

# Thoại qua LiveKit (thiếu một trong ba thì ẩn thoại)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
